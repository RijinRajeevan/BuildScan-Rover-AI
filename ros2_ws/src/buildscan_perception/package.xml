<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>buildscan_perception</name>
  <version>1.0.0</version>
  <description>
    YOLO26n-seg crack detection ROS2 node for BuildScan Rover.
    Runs on the LAPTOP with GPU inference.
    Subscribes to /camera/image_raw, publishes /inspection/result.
    Preserves original crack measurement and severity methodology from app.py.
  </description>
  <maintainer email="buildscan@example.com">BuildScan Team</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>buildscan_interfaces</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
